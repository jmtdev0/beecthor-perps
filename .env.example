# Default environment is non-executing shadow mode.
PERPS_ENV=shadow
BROKER=paper

# Binance USD-M Futures endpoints.
# Official testnet REST base URL is currently https://demo-fapi.binance.com.
BINANCE_BASE_URL=https://demo-fapi.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Mainnet is blocked unless all real-money guards are explicit.
ACCOUNT_ROLE=testnet
BINANCE_CONFIRMED_SUBACCOUNT_ID=
I_UNDERSTAND_THIS_IS_REAL_MONEY=false

# Local hard limits. Keep these tiny until the strategy has weeks of logs.
SYMBOL_ALLOWLIST=BTCUSDT
DEFAULT_NOTIONAL_USDT=100
MAX_NOTIONAL_USDT=125
MAX_LEVERAGE=3
DAILY_LOSS_LIMIT_USDT=25
MAX_OPEN_POSITIONS=1
MARKET_DATA_MAX_AGE_SECONDS=20
