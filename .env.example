# Default environment is non-executing shadow mode.
PERPS_ENV=shadow
BROKER=paper

# Binance USD-M Futures endpoints.
# Official testnet REST base URL is currently https://demo-fapi.binance.com.
BINANCE_BASE_URL=https://demo-fapi.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Latest Beecthor thesis produced by the beecthor-summary repository.
BEECTHOR_THESIS_FILE=E:\Software\Coding\beecthor-summary\data\perps_theses\latest.json

# Optional Telegram notifications via the existing BeecthorDaily bot.
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Perps alerts should normally go to the personal chat, not the Beecthor group.
TELEGRAM_PERSONAL_CHAT_ID=
TELEGRAM_CHAT_ID=

# Mainnet is blocked unless all real-money guards are explicit.
ACCOUNT_ROLE=testnet
BINANCE_CONFIRMED_SUBACCOUNT_ID=
I_UNDERSTAND_THIS_IS_REAL_MONEY=false

# Local hard limits. Keep these tiny until the strategy has weeks of logs.
# Both symbols are enabled for Demo. BTCUSDC remains the default command symbol.
SYMBOL_ALLOWLIST=BTCUSDC,BTCUSDT
POSITION_MODE=one_way
DEFAULT_NOTIONAL_USDC=100
MAX_NOTIONAL_USDC=150
MAX_TOTAL_NOTIONAL_USDC=300
MAX_LEVERAGE=5
DAILY_LOSS_LIMIT_USDC=25
MAX_OPEN_POSITIONS=3
MAX_OPEN_POSITIONS_PER_SIDE=2
MARKET_DATA_MAX_AGE_SECONDS=20

# Strategy profile. Conservative preserves the original two-candle, 1.5R behavior.
# Demo learning is more active: one 5m confirmation and first target that reaches 1.0R.
STRATEGY_PROFILE=conservative
MIN_REWARD_RISK=1.5
TARGET_SELECTION=first
CONFIRMATION_POLICY=two_5m
